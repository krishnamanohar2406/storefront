# Copy this file to .env for local development, or set these as
# environment variables in your Render dashboard for production.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# Database (Render's free Postgres provides this automatically as an
# environment variable once you add it to your web service — you don't
# need to set it by hand. Leave unset locally to use the MySQL docker-compose setup.)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Razorpay (test mode keys shown — replace with your own)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
